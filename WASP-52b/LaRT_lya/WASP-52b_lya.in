&parameters
 !=====================================================================
 ! LaRT spherical-illumination Ly-alpha RT for WASP-52b.
 ! Atmospheric structure (n_HI, T, v_radial) from the EXHALE run
 ! fxuv0p25_he98 (0.5 F0 = Yan best-fit flux, H/He = 98/2, 10 R_p domain).
 ! Incident stellar Ly-alpha line profile follows Yan et al. (2022):
 ! double-Gaussian, peaks at +/-74 km/s, width(sigma) 49 km/s,
 ! total integrated flux ~ 37,300 erg cm^-2 s^-1 at the planet
 ! (the flux is the normalization; line_profile_lya.txt holds the shape).
 ! Length unit distance2cm = R_p (so all radii/lengths are in R_p).
 !=====================================================================

 par%no_photons  = 1e7

 par%DGR         = 0.0           ! no dust
 par%use_stokes  = .false.

 par%comoving_source = .false.
 par%save_Jin        = .true.    ! save J_Lya inside the atmosphere (-> H n=2 / H-alpha)
 par%save_direc0     = .true.
 par%recoil          = .true.
 par%save_all        = .false.

 !-- scattering rate P_alpha output geometry: 2 = cylindrical (2D, axisymmetric
 !   about the star-planet axis). The stellar illumination breaks spherical
 !   symmetry, so P_alpha(r,theta) is cylindrically symmetric -- this is the
 !   grid needed to build the 2D H(2p) population for the H-alpha transit.
 par%geometry_JPa = 2

 !-- incident stellar Ly-alpha spectrum (Yan 2022 double-Gaussian) --
 par%spectral_type       = 'line_prof_file'
 par%line_prof_file      = './line_profile_lya.txt'
 par%line_prof_file_type = 1

 !-- spherical planetary atmosphere illuminated by the spherical star --
 par%geometry        = 'spherical_atmosphere'
 par%source_geometry = 'stellar_illumination'
 par%dens_file       = './dens_profile.txt'   ! n_HI  [cm^-3]
 par%temp_file       = './temp_profile.txt'   ! T     [K]
 par%velo_file       = './velo_profile.txt'   ! v_r   [km/s]

 !-- length unit: 1 code unit = R_p (WASP-52b, 1.27 R_J) in cm --
 par%distance2cm  = 8.8787d9

 !-- spectral sampling around Ly-alpha 1215.67 A --
 par%wavelength_min = 1214.0
 par%wavelength_max = 1217.4
 par%nwavelength    = 161

 !-- Cartesian grid covering the r = 1..10 R_p atmosphere --
 par%nx     = 201
 par%ny     = 201
 par%nz     = 201
 par%xmax   = 10
 par%ymax   = 10
 par%zmax   = 10
 par%rmin   = 1.0
 par%rmax   = 10.0

 !-- star-planet geometry (in R_p units) --
 !   a/R_p = 0.0272 au / R_p ;  R_star/R_p ~ 6.2 (Yan: "~6 R_p")
 par%distance_star_to_planet = 45.829
 par%stellar_radius          = 6.193

 !-- distance to the system (WASP-52 ~ 174 pc); only scales output images,
 !   not the internal J_Lya. --
 par%distance = 5.37d20

 !-- observer & detector (peel-off image; transit view along star-planet axis) --
 par%save_peeloff_2D = .true.
 par%save_peeloff_3D = .false.
 par%nxim = 201
 par%nyim = 201
 par%out_bitpix = -64
 par%alpha = 0.0
 par%beta  = 90.0
 par%gamma = 90.0

 par%out_merge = .true.
 par%nprint = 1e6
/
