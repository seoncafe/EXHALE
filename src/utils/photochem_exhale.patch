+                if worst_residual <= closure_rtol:
+                    accepted = True
+                    break
+            if not accepted:
+                raise RuntimeError(
+                    'Chemical equilibrium failed elemental closure at '
+                    f'level {i} (P={P[i]:.8e} dyn/cm^2, T={T[i]:.8e} K): '
+                    f'largest relative residual {worst_residual:.3e}, '
+                    f'tolerance {closure_rtol:.3e}'
+                )
+            for j,sp in enumerate(gas.gas_names):
