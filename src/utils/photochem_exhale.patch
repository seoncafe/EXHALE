+def test_equilibrate_trace_element_closure():
+    # A helium-dominated gas with C, N and O at 1e-9 of the atoms: every
+    # element of the request is conserved to the relative tolerance, not
+    # only the dominant one.
+    abundances = {"H": 1.0, "He": 1.0e5, "C": 2.763e-4, "N": 7.81e-5,
+                  "O": 6.03e-4}
+    with tempfile.TemporaryDirectory() as directory:
+        thermo_file = _trace_element_thermo(directory)
+        for pressure, temperature in [(2.0e7, 319.0), (1.0e6, 250.0),
+                                      (1.0e3, 221.0), (1.0e1, 221.0)]:
+            cea = equilibrate.ChemEquiAnalysis(thermo_file)
+            cea.mass_tol = 1.0e-12
+            request = np.array([abundances[a] for a in cea.atoms_names])
+            request = request / np.sum(request)
+            assert cea.solve(pressure, temperature, molfracs_atoms=request)
+            assert not np.any(np.asarray(cea.molfracs_atoms_condensate) > 0.0)
+            residual = np.abs(np.asarray(cea.molfracs_atoms) / request - 1.0)
+            assert np.max(residual) <= 1.0e-10, (pressure, temperature, residual)
+
+
+_HELIUM_GAS = {"H": 1.0, "He": 1.0e5, "C": 2.763e-4, "N": 7.81e-5,
+               "O": 6.03e-4}
+_NAME_PROPERTIES = ("gas_names", "condensate_names", "species_names",
+                    "atoms_names")
+
+
+def _helium_gas_request(cea):
+    request = np.array([_HELIUM_GAS[a] for a in cea.atoms_names])
+    return request / np.sum(request)
+
+
+def _element_residual(cea, request):
+    return float(np.max(np.abs(np.asarray(cea.molfracs_atoms) / request - 1.0)))
+
+
+def test_equilibrate_hot_high_pressure_single_solve_closes_elements():
+    # One solve at 2e7 dyn/cm^2 and 1500 K on a fresh object; the convergence
+    # flag must report the closed solution, not a near-initial composition.
+    with tempfile.TemporaryDirectory() as directory:
+        cea = equilibrate.ChemEquiAnalysis(_trace_element_thermo(directory))
+        cea.mass_tol = 1.0e-12
+        request = _helium_gas_request(cea)
+        assert cea.solve(2.0e7, 1500.0, molfracs_atoms=request)
+        assert _element_residual(cea, request) <= 1.0e-10
+
+
+def test_equilibrate_successive_solves_independent_of_name_reads():
+    # Successive solves on ONE object (cold low pressure and hot high
+    # pressure, both orders) with 0, 1 and 5 reads of each name property
+    # between them: every solve reports convergence, closes every element to
+    # 1e-10, and gives the same composition whatever was read in between.
+    pairs = (((10.0, 221.0), (2.0e7, 1500.0)),
+             ((2.0e7, 1500.0), (10.0, 221.0)))
+    with tempfile.TemporaryDirectory() as directory:
+        thermo_file = _trace_element_thermo(directory)
+        for pair in pairs:
+            outcomes = []
+            for prop in _NAME_PROPERTIES:
+                for reads in (0, 1, 5):
+                    cea = equilibrate.ChemEquiAnalysis(thermo_file)
+                    cea.mass_tol = 1.0e-12
+                    request = _helium_gas_request(cea)
+                    flags, residuals, species = [], [], []
+                    for pressure, temperature in pair:
+                        flags.append(cea.solve(pressure, temperature,
+                                               molfracs_atoms=request))
+                        residuals.append(_element_residual(cea, request))
+                        species.append(np.asarray(cea.molfracs_species_gas))
+                        for _ in range(reads):
+                            getattr(cea, prop)
+                    outcomes.append((prop, reads, flags, residuals, species))
+            for prop, reads, flags, residuals, species in outcomes:
+                assert all(flags), (pair, prop, reads, flags, residuals)
+                assert max(residuals) <= 1.0e-10, (pair, prop, reads, residuals)
+                for first, other in zip(outcomes[0][4], species):
+                    assert np.allclose(other, first, rtol=1.0e-10, atol=1.0e-30), \
+                        (pair, prop, reads)
+
+
+def test_gas_giant_composition_closure_regimes():
+    from photochem.extensions.gasgiants import composition_at_metallicity
+
+    pressure = np.logspace(7.0, 2.0, 8)
+    with tempfile.TemporaryDirectory() as directory:
+        thermo_file = _trace_element_thermo(directory)
+
+        # No condensate anywhere: every level passes the elemental closure.
+        cea = equilibrate.ChemEquiAnalysis(thermo_file)
+        cea.mass_tol = 1.0e-12
+        out, mubar = composition_at_metallicity(
+            cea, np.linspace(1500.0, 700.0, 8), pressure, 1.0, 1.0
+        )
+        assert np.all(np.isfinite(mubar))
+        assert not cea.use_prev_guess
+
+        # Water condenses in the upper levels and is rained out: those levels
+        # are exempt from the closure test and the column still solves.
+        cea = equilibrate.ChemEquiAnalysis(thermo_file)
+        cea.mass_tol = 1.0e-12
+        out, mubar = composition_at_metallicity(
+            cea, np.linspace(350.0, 180.0, 8), pressure, 1.0, 1.0
+        )
+        assert np.all(np.isfinite(mubar))
+        assert out["H2O"][-1] < 0.9 * out["H2O"][0]
+        assert not cea.use_prev_guess
+
