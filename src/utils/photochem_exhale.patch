+"""Tests of what Equilibrate reports as converged.
+
+A solve is reported as converged only if the iteration met its convergence
+tests and the returned state passed the guards: no condensate stage ended by
+the negative-condensate rule, no exactly zero LU pivot, and a final state in
+which no absent condensate satisfies the solver's own inclusion test, no
+included condensed amount is negative and every amount is finite.  The reason
+of a refusal is ChemEquiAnalysis.nonconvergence_reason.
+
+Every state reported as converged is also checked here independently of the
+solver: the element inventory of the returned state (gas plus condensed
+phases) against the request, and the affinity of every absent condensate,
+computed in Python from the returned gas composition and the thermodynamic
+data of the yaml file.
+"""
+import math
+from pathlib import Path
+
+import numpy as np
+import pytest
+import yaml
+
+from photochem.equilibrate import ChemEquiAnalysis, generate_zahnle_earth_thermo
+from photochem.extensions import gasgiants
+
+HERE = Path(__file__).parent
+THERMO_18 = HERE / 'thermo_easy_chem_simp_own.yaml'
+ATOMS_18 = ['H', 'He', 'C', 'N', 'O', 'Na', 'Mg', 'Al', 'Si', 'P', 'S', 'Cl', 'K',
+            'Ca', 'Ti', 'V', 'Fe', 'Ni']
+X_18 = np.array([9.207539305e-01, 7.83688694e-02, 2.478241e-04, 6.225060569498810e-05,
+                 4.509658e-04, 1.600086943532050e-06, 3.665587420553620e-05, 2.595e-06,
+                 2.9795e-05, 2.366702019976680e-07, 1.213790073460400e-05,
+                 2.911679584995890e-07, 9.866056119256769e-08, 2.014390114292550e-06,
+                 8.206228043663590e-08, 7.836886940899920e-09, 2.911679584995890e-05,
+                 1.528071168062810e-06])
+R_GAS = 8.3144598  # J/(K mol), the value of equilibrate_const
+
+
+# --- independent check of a returned state -------------------------------
+
+def gibbs_over_RT(entry, T):
+    """g/RT of a species from its yaml thermodynamic entry (the formulas of
+    equilibrate_cea.f90 for NASA9 and Shomate data), or None outside the data
+    temperature range."""
+    th = entry['thermo']
+    ranges = th['temperature-ranges']
+    if T < ranges[0] or T > ranges[-1]:
+        return None
+    k = max(0, min(len(ranges) - 2, int(np.searchsorted(ranges, T, side='right')) - 1))
+    c = th['data'][k]
+    if th['model'] == 'NASA9':
+        h = (-c[0]*T**-2 + c[1]*math.log(T)/T + c[2] + c[3]*T/2 + c[4]*T**2/3
+             + c[5]*T**3/4 + c[6]*T**4/5 + c[7]/T)
+        s = (-c[0]*T**-2/2 - c[1]/T + c[2]*math.log(T) + c[3]*T + c[4]*T**2/2
+             + c[5]*T**3/3 + c[6]*T**4/4 + c[8])
+        return h - s
+    if th['model'] == 'Shomate':
+        t = T/1000.0
+        h = 1000.0*(c[0]*t + c[1]*t**2/2 + c[2]*t**3/3 + c[3]*t**4/4 - c[4]/t + c[5])
+        s = c[0]*math.log(t) + c[1]*t + c[2]*t**2/2 + c[3]*t**3/3 - c[4]/(2*t**2) + c[6]
+        return h/(R_GAS*T) - s/R_GAS
+    raise ValueError('unsupported thermodynamic model ' + th['model'])
+
+
+def independent_check(cea, thermofile, P, T, x_request, closure_rtol):
+    """(element departure, list of (absent condensate, affinity) with a
+    negative affinity) of the returned state.  The element potentials pi are
+    the least-squares solution of mu_j/RT = g_j/RT + ln(x_j P/1 bar) = sum_e
+    a_je pi_e over the gas species with x_j > 1e-20; an absent condensate c
+    whose data cover T qualifies when g_c/RT - sum_e a_ce pi_e < -1e-3 (the
+    margin covers the convergence tolerance of pi)."""
+    data = {s['name']: s for s in yaml.safe_load(open(thermofile))['species']}
+    atoms = [a.strip() for a in cea.atoms_names]
+    x_tot = np.asarray(cea.molfracs_atoms)
+    positive = x_request > 0
+    departure = float(np.max(np.abs(x_tot[positive]/x_request[positive] - 1)))
+    rows, mu = [], []
+    for name, x in zip(cea.gas_names, cea.molfracs_species_gas):
+        if x > 1e-20:
+            g = gibbs_over_RT(data[name], T)
+            if g is None:
+                continue
+            rows.append([data[name]['composition'].get(a, 0) for a in atoms])
+            mu.append(g + math.log(x*P/1e6))
+    pi = np.linalg.lstsq(np.array(rows, float), np.array(mu), rcond=None)[0]
+    present = {n for n, v in zip(cea.condensate_names, cea.molfracs_species_condensate) if v > 0}
+    qualifying = []
+    for name in cea.condensate_names:
+        if name in present:
+            continue
+        g = gibbs_over_RT(data[name], T)
+        if g is None:
+            continue
+        a = g - sum(data[name]['composition'].get(e, 0)*p for e, p in zip(atoms, pi))
+        if a < -1e-3:
+            qualifying.append((name, a))
+    return departure, qualifying
+
+
+def solve_18(k, mass_tol):
+    cea = ChemEquiAnalysis(str(THERMO_18), atoms=ATOMS_18)
+    cea.mass_tol = mass_tol
+    X = X_18.copy()
+    X[6] *= 1 + k*2.0**-52
+    ok = cea.solve(1.0e6, 1000.0, molfracs_atoms=X)
+    return cea, ok, X/X.sum()
+
+
+# --- T1: the 18-element condensing case ------------------------------------
+
+@pytest.mark.parametrize('mass_tol', [1e-2, 1e-4, 1e-6])
+def test_18_element_states_are_verified_or_refused_with_a_reason(mass_tol):
+    converged = refused = 0
+    for k in range(32):
+        try:
+            cea, ok, x = solve_18(k, mass_tol)
+        except Exception as exc:          # a solver error is a refusal too
+            assert 'singular' in str(exc)
+            refused += 1
+            continue
+        if ok:
+            converged += 1
+            assert cea.nonconvergence_reason == ''
+            departure, qualifying = independent_check(cea, THERMO_18, 1.0e6, 1000.0, x, mass_tol)
+            assert departure <= 10*mass_tol
+            assert qualifying == []
+        else:
+            refused += 1
+            assert cea.nonconvergence_reason != ''
+    print('mass_tol %g: converged and verified %d, refused %d' % (mass_tol, converged, refused))
+
+
+def test_independent_check_finds_the_phase_the_solver_names():
+    # A refused state still returns its composition; the phase the solver's
+    # final inclusion test names must also qualify in the independent check.
+    for k in range(32):
+        cea, ok, x = solve_18(k, 1e-4)
+        if 'absent condensate KAlSi3O8(c)' in cea.nonconvergence_reason:
+            _, qualifying = independent_check(cea, THERMO_18, 1.0e6, 1000.0, x, 1e-4)
+            assert 'KAlSi3O8(c)' in [n for n, _ in qualifying]
+            return
+    pytest.fail('no state named KAlSi3O8(c) as a qualifying absent phase')
+
+
+# --- T2: the Mg2SiO4 + SiO2 + MgSiO3 path ----------------------------------
+
+def test_dependent_condensate_path_is_refused():
+    # Unperturbed input, mass_tol 1e-4: the active set passes through
+    # {Mg2SiO4, SiO2} and then {Mg2SiO4, SiO2, MgSiO3} (linearly dependent:
+    # Mg2SiO4 + SiO2 = 2 MgSiO3), ending stages by the negative-condensate rule.
+    cea, ok, x = solve_18(0, 1e-4)
+    assert not ok
+    assert 'negative condensed amount' in cea.nonconvergence_reason
+
+
+# --- G1 holds across the internal restart with the long matrix -------------
+
+def test_negative_rule_refusal_survives_the_internal_restart():
+    # mass_tol 1e-3, Mg factor 1 + 24*2**-52: the rule fires in the quick
+    # iteration, the solver restarts with the long matrix, and that attempt
+    # meets the iteration's convergence tests (an unguarded build reports
+    # True).  The refusal must survive the restart.
+    cea, ok, x = solve_18(24, 1e-3)
+    assert not ok
+    assert 'negative condensed amount' in cea.nonconvergence_reason
+
+
+# --- the reason belongs to the last solve -----------------------------------
+
+def test_reason_is_reset_by_every_solve_on_one_object():
+    cea = ChemEquiAnalysis(str(THERMO_18), atoms=ATOMS_18)
+    cea.mass_tol = 1e-4
+    assert not cea.solve(1.0e6, 1000.0, molfracs_atoms=X_18)
+    assert cea.nonconvergence_reason != ''
+    # A hot state without condensates on the same object.
+    assert cea.solve(1.0e6, 3000.0, molfracs_atoms=X_18)
+    assert cea.nonconvergence_reason == ''
+
+
+# --- T4 and the returned-state correction: water condensing ----------------
+
+RATIOS = dict(H=1.0, N=8.18465e-05, O=6.06178e-04, C=2.77588e-04)
+
+
+@pytest.fixture(scope='module')
+def zahnle_thermo(tmp_path_factory):
+    f = str(tmp_path_factory.mktemp('zahnle')/'thermo.yaml')
+    generate_zahnle_earth_thermo(f, atoms_names=['H', 'He', 'N', 'O', 'C'])
+    return f
+
+
+def request(cea, heh):
+    r = dict(RATIOS, He=heh)
+    x = np.array([r[a.strip()] for a in cea.atoms_names])
+    return x/x.sum()
+
+
+@pytest.mark.parametrize('heh', [100.0, 14.0, 5.0, 1.2, 0.1])
+@pytest.mark.parametrize('P_bar', [5.7, 0.33])
+def test_water_condensing_solves_converge_and_are_verified(zahnle_thermo, heh, P_bar):
+    cea = ChemEquiAnalysis(zahnle_thermo)
+    cea.mass_tol = 1e-6
+    x = request(cea, heh)
+    assert cea.solve(P_bar*1e6, 221.0, molfracs_atoms=x)
+    assert cea.nonconvergence_reason == ''
+    departure, qualifying = independent_check(cea, zahnle_thermo, P_bar*1e6, 221.0, x, 1e-6)
+    # The element balance is converged to mass_tol; measured 1e-14 to 1e-13
+    # where water condenses and up to 8.4e-8 in the gas-only solves.
+    assert departure <= cea.mass_tol
+    assert qualifying == []
+    print('He/H %g, %g bar: condensates %s, element departure %.2e'
+          % (heh, P_bar, [n for n, v in zip(cea.condensate_names, cea.molfracs_species_condensate) if v > 0], departure))
+
+
+def test_condensate_of_the_previous_level_is_not_returned(zahnle_thermo):
+    # Previous-guess sequence with rainout: water condenses at the first
+    # levels; above them the rained-out gas is undersaturated, so the
+    # returned state has no condensate and its total equals the request.
+    cea = ChemEquiAnalysis(zahnle_thermo)
+    cea.mass_tol = 1e-6
+    x = request(cea, 1.2)
+    levels = [(8.0, 260.0), (5.7, 230.0), (3.0, 221.0), (1.0, 221.0), (0.33, 221.0), (0.1, 221.0)]
+    seen_condensate = False
+    for i, (P_bar, T) in enumerate(levels):
+        cea.use_prev_guess = i > 0
+        assert cea.solve(P_bar*1e6, T, molfracs_atoms=x)
+        cond = np.asarray(cea.molfracs_species_condensate)
+        departure = np.max(np.abs(np.asarray(cea.molfracs_atoms)[x > 0]/x[x > 0] - 1))
+        assert departure <= 1e-10
+        if np.any(cond > 0):
+            seen_condensate = True
+        elif seen_condensate:
+            assert np.all(cond == 0.0)
+            assert np.all(np.asarray(cea.molfracs_atoms_condensate) == 0.0)
+        x = np.asarray(cea.molfracs_atoms_gas).copy()
+    assert seen_condensate
