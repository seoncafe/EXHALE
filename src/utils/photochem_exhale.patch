+# --- T5: elemental closure in gasgiants.composition_at_metallicity ---------
+
+def column_levels():
+    P = np.array([16.7, 8.19, 5.73, 4.0, 2.0, 1.0, 0.33, 0.1, 0.01])*1e6
+    T = np.array([319.5, 240.2, 221.0, 221.0, 221.0, 221.0, 221.0, 221.0, 221.0])
+    return P, T
+
+
+def test_column_with_water_condensing_passes_the_closure_check(zahnle_thermo):
+    gas = ChemEquiAnalysis(zahnle_thermo)
+    gas.molfracs_atoms_sun = request(gas, 1.2)
+    P, T = column_levels()
+    mix, mubar = gasgiants.composition_at_metallicity(gas, T, P, 1.0, 1.0, rainout_condensed_atoms=True)
+    assert np.all(np.isfinite(mubar))
+
+
+def test_single_deep_level_call_applies_the_closure_check(zahnle_thermo):
+    # The shape of the deeper-atmosphere call of return_atmosphere: one level,
+    # here a condensing one.
+    gas = ChemEquiAnalysis(zahnle_thermo)
+    gas.molfracs_atoms_sun = request(gas, 1.2)
+    mix, mubar = gasgiants.composition_at_metallicity(
+        gas, np.array([230.0]), np.array([5.7e6]), 1.0, 1.0, rainout_condensed_atoms=True)
+    assert mix['H2O'][0] > 0.0
