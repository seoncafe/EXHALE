+
+class TamperedTotal:
+    """A solver whose returned total inventory is off by 1e-3 in oxygen."""
+    def __init__(self, gas):
+        self._gas = gas
+    def __getattr__(self, name):
+        return getattr(self._gas, name)
+    def __setattr__(self, name, value):
+        if name == '_gas':
+            object.__setattr__(self, name, value)
+        else:
+            setattr(self._gas, name, value)
+    @property
+    def molfracs_atoms(self):
+        x = np.array(self._gas.molfracs_atoms)
+        x[[a.strip() for a in self._gas.atoms_names].index('O')] *= 1.001
+        return x/x.sum()
+
+
+@pytest.mark.parametrize('levels', ['column', 'single'])
+def test_tampered_total_inventory_is_refused(zahnle_thermo, levels):
+    gas = TamperedTotal(ChemEquiAnalysis(zahnle_thermo))
+    gas.molfracs_atoms_sun = request(gas._gas, 1.2)
+    P, T = column_levels() if levels == 'column' else (np.array([5.7e6]), np.array([230.0]))
+    with pytest.raises(RuntimeError, match='elemental closure'):
+        gasgiants.composition_at_metallicity(gas, T, P, 1.0, 1.0, rainout_condensed_atoms=True)
